# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ L'ENVIRONNEMENT DE LA PILE DOCKER.                                      ║
# ║                                                                          ║
# ║     cp docker/env.exemple .env                                           ║
# ║     node docker/generer-cles.mjs >> .env      # les six secrets          ║
# ║     chmod 600 .env                                                       ║
# ║                                                                          ║
# ║ Ce fichier s'appelle `docker/env.exemple` et non `.env.docker.example`   ║
# ║ parce que le `.gitignore` du dépôt ignore `.env*` : l'exemple aurait     ║
# ║ disparu du dépôt sans un mot.                                            ║
# ║                                                                          ║
# ║ ⚠️ IL N'A RIEN À VOIR AVEC `.env.local`, qui sert au développement sur   ║
# ║ la machine (`npm run dev` + `supabase start`). Les noms sont d'ailleurs  ║
# ║ différents à dessein — `SUPABASE_PUBLIC_URL` ici, `NEXT_PUBLIC_SUPABASE_ ║
# ║ URL` là — pour que Next, qui lit aussi `.env`, n'aille pas y prendre une ║
# ║ valeur destinée aux conteneurs.                                          ║
# ╚══════════════════════════════════════════════════════════════════════════╝


# ─────────────────────────────────────────────────────────────────────────────
# LES ADRESSES
# ─────────────────────────────────────────────────────────────────────────────

# L'adresse publique du site. En local : http://localhost:3000
APP_PUBLIC_URL=https://editionsmapoukam.com

# L'adresse publique de Supabase. Le NAVIGATEUR y va directement : les
# couvertures viennent du bucket public et les téléchargements sont des URL
# signées du stockage. Sur un VPS : https://api.DOMAINE
SUPABASE_PUBLIC_URL=https://api.editionsmapoukam.com

# Le nom par lequel le conteneur `app` joint la passerelle (voir le commentaire
# du service `passerelle` dans docker-compose.yml).
#   EN LOCAL   : le même hôte que SUPABASE_PUBLIC_URL, sans le schéma ni le port
#   SUR UN VPS : un nom INUTILISÉ, par ex. `passerelle.interne` — le DNS public
#                fait le travail, et un alias capterait l'URL https à tort
SUPABASE_ALIAS_INTERNE=api.editionsmapoukam.com

# Les retours autorisés après une connexion. gotrue refuse toute adresse
# absente de cette liste, et le refus n'arrive qu'AU RETOUR, sans nommer sa
# cause. Les deux formes (localhost et 127.0.0.1) parce que le navigateur et
# `site_url` ne s'accordent pas toujours sur laquelle ils emploient.
AUTH_REDIRECTIONS_AUTORISEES=https://editionsmapoukam.com/api/auth/google/retour,https://editionsmapoukam.com/api/better-auth/callback/google

# Ports publiés, tous sur 127.0.0.1 (voir l'en-tête du docker-compose.yml).
APP_PORT=3000
PASSERELLE_PORT=8000
POSTGRES_PORT=54322


# ─────────────────────────────────────────────────────────────────────────────
# LES SECRETS — produits par `node docker/generer-cles.mjs >> .env`
#
# Ne rien recopier d'un tutoriel : les clés qui y circulent sont publiques, et
# leur `service_role` ouvre la base entière, RLS contourné.
# ─────────────────────────────────────────────────────────────────────────────
# POSTGRES_PASSWORD=
# JWT_SECRET=
# ANON_KEY=
# SERVICE_ROLE_KEY=
# FAKE_WEBHOOK_SECRET=
# BETTER_AUTH_SECRET=

JWT_EXPIRY=3600
REGION=eu-west-1


# ─────────────────────────────────────────────────────────────────────────────
# LES IMAGES
#
# ⚠️ ÉPINGLER, ET VÉRIFIER. Ces étiquettes sont des valeurs de départ, pas une
# vérité : les versions de Supabase auto-hébergé changent, et les noms de
# variables d'environnement changent avec elles. La source qui fait foi est la
# composition officielle de la version visée :
#
#   git clone --depth 1 --branch self-hosted/v0.8.1 https://github.com/supabase/supabase
#   grep 'image:' supabase/docker/docker-compose.yml
#
# Une étiquette inexistante échoue au `pull`, franchement. Une étiquette trop
# récente démarre et se tait — c'est le cas à surveiller.
# ─────────────────────────────────────────────────────────────────────────────
IMAGE_POSTGRES=supabase/postgres:17.4.1.075
IMAGE_GOTRUE=supabase/gotrue:v2.179.0
IMAGE_POSTGREST=postgrest/postgrest:v13.0.4
IMAGE_STORAGE=supabase/storage-api:v1.25.7
IMAGE_IMGPROXY=darthsim/imgproxy:v3.8.0
IMAGE_STUDIO=supabase/studio:2025.06.30-sha-6f5982d
IMAGE_PG_META=supabase/postgres-meta:v0.91.0

APP_VERSION=local


# ─────────────────────────────────────────────────────────────────────────────
# LE COURRIER
#
# Deux usages distincts, et une seule boîte ne couvre PAS les deux :
#   SMTP_*  → les CODES À SIX CHIFFRES de gotrue (inscription, mot de passe
#             oublié). Sans lui, plus personne ne peut confirmer son adresse.
#   MAILER  → les emails de l'APPLICATION (confirmations de commande…).
#             L'application n'a pas d'adaptateur SMTP : `file` écrit sur le
#             disque et n'envoie rien, `resend` passe par l'API.
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@editionsmapoukam.com

MAILER=file
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Court-circuite la vérification de l'adresse. POUR UNE MISE EN LIGNE SANS
# SERVICE D'EMAIL, ET RIEN D'AUTRE : quelqu'un peut alors s'inscrire avec une
# adresse qui n'est pas la sienne.
AUTH_CONFIRMATION_AUTOMATIQUE=false


# ─────────────────────────────────────────────────────────────────────────────
# LES ADAPTATEURS
# ─────────────────────────────────────────────────────────────────────────────

# fake | notchpay — l'adaptateur refuse de démarrer sur une clé sans `test_`
# tant que NOTCHPAY_AUTORISER_PRODUCTION vaut false.
PAYMENT_PROVIDER=fake
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_PRIVATE_KEY=
NOTCHPAY_HASH_KEY=
NOTCHPAY_AUTORISER_PRODUCTION=false

# desactive | supabase | better-auth — `desactive` est le défaut, et sous ce
# défaut aucune route Google ne répond et aucun bouton n'apparaît.
AUTH_GOOGLE=desactive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# À passer à `true` UNIQUEMENT sous AUTH_GOOGLE=supabase : c'est ce qui allume
# le fournisseur côté gotrue. Sous `better-auth`, l'échange ne passe pas par
# lui, et l'allumer exposerait une seconde porte que rien n'utilise.
GOOGLE_PAR_SUPABASE=false


# ─────────────────────────────────────────────────────────────────────────────
# L'APPLICATION
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_DESIGN_VERSION=v3

# Plafonds durs, réappliqués dans le code : une valeur supérieure est ramenée
# au plafond plutôt que servie.
SIGNED_URL_TTL=300
SIGNED_URL_TTL_FREE=3600

EXCERPT_PAGES_DEFAULT=3
ANON_PAGE_RATE_LIMIT=60
PAYMENT_GRACE_PERIOD_DAYS=7
INVOICE_RETENTION_YEARS=10
LOG_LEVEL=info
