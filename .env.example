# .env.example — à commiter (sans valeurs sensibles)
# Copier en .env.local. Aucune clé de service externe n'est nécessaire.

# ---- Supabase local ----
# Ces valeurs sont affichées par `npm run supabase:start`. Ce sont des
# identifiants de développement locaux, pas des secrets de production.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# FACULTATIVE. L application ne la lit jamais : elle parle a la base par
# l API Supabase. Seuls les scripts (db:seed, purge:invoices) et les tests
# ouvrent une connexion directe. Inutile en hebergement.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ---- Adaptateurs ----
# Quel adaptateur brancher. Valeurs servies : fake | notchpay
#   fake     — la console de simulation locale, aucun compte nulle part
#   notchpay — le vrai prestataire, en mode TEST (voir docs/NOTCHPAY.md)
PAYMENT_PROVIDER=fake
# Valeurs possibles : file | resend (resend non implémenté à ce stade)
MAILER=file
# Dossier où FileMailer écrit les emails simulés
MAIL_OUTPUT_DIR=.mails
# Secret local utilisé pour signer les webhooks du faux prestataire.
# Non sensible, mais doit exister pour que la vérification de signature soit réelle.
FAKE_WEBHOOK_SECRET=dev_local_webhook_secret

# ---- Notch Pay ----
# Les TROIS clés sont exigées ensemble dès que PAYMENT_PROVIDER=notchpay.
# Elles se copient depuis le tableau de bord Notch Pay, en mode Test :
#   Settings > API Keys  (https://business.notchpay.co)
#
# Chacune a un rôle, et elles ne se remplacent pas :
#   pk_test_…  clé PUBLIQUE  — en-tête `Authorization`, ouvre et relit un paiement
#   sk_test_…  clé PRIVÉE    — en-tête `X-Grant`, exigée par le remboursement
#   hsk_test_… clé de HACHAGE — vérifie la SIGNATURE des webhooks, et elle seule
#
# Aucune n est prefixee NEXT_PUBLIC_, pas meme la « publique » : tout part du
# serveur, et une cle exposee est une cle a faire tourner.
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_PRIVATE_KEY=
NOTCHPAY_HASH_KEY=

# Autoriser les cles de PRODUCTION (pk_live_…). L adaptateur REFUSE de demarrer
# sur une cle sans `test_` tant que ceci vaut false. Ne passer a true que le
# jour ou l on encaisse reellement.
NOTCHPAY_AUTORISER_PRODUCTION=false

# ---- Authentification ----
# Confirme automatiquement l adresse email a l inscription.
#
# POUR UNE MISE EN LIGNE SANS SERVICE D EMAIL, ET RIEN D AUTRE. Aucun email
# ne quitte la machine : le code a six chiffres n atteindrait personne, et
# l inscription serait une impasse. Ne touche PAS l authentification
# elle-meme — mot de passe, session, rotation des jetons, revocation restent
# reels ; seule l etape de VERIFICATION est court-circuitee.
#
# Ce qu on accepte en l activant : quelqu un peut s inscrire avec une adresse
# qui n est pas la sienne. Tenable tant qu aucun email ne part et qu aucun
# paiement reel n est encaisse ; a desactiver des qu un service d email est
# branche.
AUTH_CONFIRMATION_AUTOMATIQUE=false

# ---- Connexion par Google ----
# Quel chemin conduit l echange OAuth. Valeurs servies :
#   desactive   — aucune route Google ne repond, aucun bouton n apparait.
#                 C est le DEFAUT : la pile locale tourne sans compte Google.
#   supabase    — Supabase Auth porte l echange. Les deux cles Google vivent
#                 CHEZ LUI (tableau de bord > Authentication > Providers), et
#                 ne sont donc pas exigees ci-dessous.
#   better-auth — Better Auth porte l echange, sans base de donnees. Les trois
#                 valeurs suivantes deviennent obligatoires.
#
# Dans les deux cas la session servie est une session SUPABASE : les droits,
# RLS et entitlements ne connaissent qu elle. Basculer d un chemin a l autre ne
# demande donc qu un redemarrage, jamais une migration.
AUTH_GOOGLE=desactive

# Client OAuth cree sur https://console.cloud.google.com/apis/credentials
# Origines JavaScript autorisees : l adresse du site, et http://localhost:3000
# URI de redirection autorisees, selon le chemin choisi :
#   supabase    — https://<ref>.supabase.co/auth/v1/callback
#                 http://127.0.0.1:54321/auth/v1/callback  (pile locale)
#   better-auth — <site>/api/better-auth/callback/google
#                 http://localhost:3000/api/better-auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret de signature de Better Auth. 32 caracteres au minimum : sans base de
# donnees, l etat de l echange voyage dans un cookie signe par lui.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# ---- Application ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Durée de validité des URL signées d'un contenu PAYANT, en secondes.
# CLAUDE.md règle 3 : plafond dur de 300 s, appliqué dans le code. Une valeur
# supérieure est ramenée au plafond.
SIGNED_URL_TTL=300

# Durée de validité des URL signées d'un titre marqué gratuit = true.
# Plafond dur de 3600 s. Voir docs/PLAN.md, décision D6.
SIGNED_URL_TTL_FREE=3600

# Fenêtre de vente exclusive avant entrée dans l'abonnement, en jours
NEW_RELEASE_WINDOW_DAYS=90
# Période de grâce après un échec de prélèvement, en jours
PAYMENT_GRACE_PERIOD_DAYS=7
# Nombre de pages d'extrait par défaut, quand le titre n'en fixe pas
EXCERPT_PAGES_DEFAULT=3
# Pages servies par heure et par adresse IP à un visiteur non authentifié
ANON_PAGE_RATE_LIMIT=60

# ---- Tarifs de démonstration, en plus petite unité monétaire ----
# Attention : toutes les devises n'ont pas deux décimales. 499 vaut 4,99 EUR,
# mais 1500 vaut 1500 FCFA. Voir docs/PLAN.md, décision D4.
PRICE_UNIT_DEFAULT=499
PRICE_SUBSCRIPTION_MONTHLY=799
PRICE_SUBSCRIPTION_YEARLY=6900

# ---- Journalisation ----
# debug | info | warn | error
LOG_LEVEL=info

# ---- Conservation comptable ----
# Durée de conservation des factures, en années (§11.3). Figée sur chaque
# facture à son émission : la modifier n'affecte pas les factures déjà émises.
# La valeur dépend du pays d'immatriculation, encore à trancher (§16.2 point 6).
INVOICE_RETENTION_YEARS=10
