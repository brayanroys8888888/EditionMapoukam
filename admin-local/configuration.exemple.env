# ╔══════════════════════════════════════════════════════════════════════════╗
# ║ ADMINISTRATION LOCALE — le modèle de configuration                       ║
# ╚══════════════════════════════════════════════════════════════════════════╝
#
# L'installateur recopie ce fichier en `admin-local/.env` et le remplit en
# vous posant trois questions. Vous pouvez aussi le faire à la main.
#
# ⚠️ `admin-local/.env` contient la CLÉ DE SERVICE : un accès total à la base
# de production. Il n'est jamais versionné (`.gitignore`), il ne s'envoie à
# personne, et ce poste doit être protégé par un mot de passe.
#
# Les trois valeurs se trouvent dans Supabase :
#   Project Settings → API → Project URL, anon public, service_role.

# L'adresse du projet Supabase hébergé.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# La clé « anon public » — elle sert à la page de connexion.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La clé « service_role » — celle qui écrit les contes.
SUPABASE_SERVICE_ROLE_KEY=

# Facultatif : le port local (3700 par défaut). Ni 3000, que le serveur de
# développement et la porte de validation se disputent déjà.
# ADMIN_LOCAL_PORT=3700

# Facultatif : la direction visuelle, si le site en ligne n'est pas en v3.
# NEXT_PUBLIC_DESIGN_VERSION=v3
