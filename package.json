{
  "name": "editionmapoukam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plateforme de contes africains illustrés — backend, 100 % local.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node scripts/porte-tests.mjs",
    "test:brut": "vitest run",
    "diff:sql": "node scripts/diff-fonctions-sql.mjs",
    "audit:epub": "vitest run --config vitest.audit.config.ts",
    "test:unit": "node scripts/porte-tests.mjs --project unit",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "db:migrate": "supabase migration up --local",
    "db:reset": "supabase db reset",
    "db:seed": "node scripts/db-seed.mjs",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "purge:invoices": "node scripts/purge-invoices.mjs",
    "test:session-longue": "node scripts/test-session-longue.mjs",
    "rendu": "playwright test",
    "rendu:ui": "playwright test --ui",
    "admin:creer": "node scripts/creer-admin.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.28.0",
    "next": "^16.2.12",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.18.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.0",
    "jsdom": "^26.1.0",
    "pg": "^8.22.0",
    "supabase": "^2.110.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "sharp": "$sharp",
    "postcss": ">8.5.17"
  }
}
